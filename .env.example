# Copy to .env (never committed) or export in your shell. All optional.

# Any OpenAI-compatible chat endpoint. Defaults target a local Ollama server.
LEMMA_LLM_BASE_URL=http://localhost:11434/v1
LEMMA_LLM_MODEL=qwen3:32b
# Leave empty for local servers; hosted endpoints need a key.
LEMMA_LLM_API_KEY=
LEMMA_LLM_TIMEOUT=600
LEMMA_LLM_TEMPERATURE=0.0
LEMMA_LLM_MAX_TOKENS=4096

# Directory containing `lean` and `lake` if they are not on PATH.
LEMMA_LEAN_BIN=
