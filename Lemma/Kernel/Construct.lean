import Lemma.Kernel.Observation

/-!
# Kernel rule 2: constructs and primitives

A construct is a function from observations to a typed value, parameterized
by the level and horizon at which the construct lives.

Three kernel notions appear here.

* `Primitive` is the base of every value type. The library declares atomic
  value types (energy, attention, ...) as structures extending `Primitive`
  and tags them `@[primitive]`. The kernel knows nothing about which
  primitives exist. The kernel only requires that every construct **reduce**
  to primitives.
* `Construct level horizon` is the scope-carrying parent of every construct
  type. A construct type is a structure extending `Construct l h`, or a
  definition which unfolds to such structures and products of them.
* `IsConstruct C` is the typeclass witnessing that `C` passed the
  reduction check. The `@[construct]` attribute (see `Lemma.Meta.Attributes`)
  runs the check and generates the instance. A proposition, aggregation or
  temporal rule over a type without this instance fails to type-check,
  which is how the kernel enforces reduction.
-/

namespace Lemma

/-- Base of every primitive value type. A reading normalized to `[0, 1]`. -/
structure Primitive where
  value : Float
  deriving Repr, Inhabited

/-- Kernel rule 2. The scope-carrying parent of every construct type. The
structure has no fields on purpose: scope lives in the type parameters so
that `Construct .Individual .Weekly` and `Construct .Team .Weekly` are
different types. -/
structure Construct (level : Level) (horizon : Horizon) where
  deriving Repr, Inhabited

/-- Witness, generated by `@[construct]`, that a type reduces to primitives
and lives at a declared scope. -/
class IsConstruct (C : Type) where
  level : Level
  horizon : Horizon

/-- Scope of a registered construct type. -/
def Construct.levelOf (C : Type) [i : IsConstruct C] : Level := i.level

/-- Horizon of a registered construct type. -/
def Construct.horizonOf (C : Type) [i : IsConstruct C] : Horizon := i.horizon

/-- A measurement model for a registered construct: the function from an
observation bundle at the construct's scope to a typed value. Measurement
models are optional in a definitional library and become mandatory when
the library is connected to data. -/
class Measures (C : Type) [IsConstruct C] where
  measure :
    ObservationBundle (Construct.levelOf C) (Construct.horizonOf C) → Option C

end Lemma
